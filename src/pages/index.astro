---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import NewsletterCard from '../components/NewsletterCard.astro';
import Footer from '../components/Footer.astro';

// Fetch structured collections
const profileEntry = await getEntry('profile', 'alex');
const linksEntry = await getEntry('links', 'links');

if (!profileEntry || !linksEntry) {
	throw new Error('Missing profile or links collection entry.');
}

const profile = profileEntry.data;
const allLinks = linksEntry.data.items;

// Group links by category, maintaining order
const categories = Array.from(new Set(allLinks.map((item) => item.category)));
---

<BaseLayout
	title={`${profile.name} (${profile.handle}) — Links`}
	description={`${profile.tagline}. ${profile.bio}`}
>
	<Header />

	<main class="shell-container flex-1 pb-12">
		<!-- Profile hero presentation -->
		<ProfileHeader profile={profile} />

		<!-- Links grouped by categories with neumorphic pill headers -->
		<div class="space-y-8 mt-4">
			{categories.map((category) => {
				const categoryLinks = allLinks.filter((l) => l.category === category);
				return (
					<section aria-labelledby={`cat-${category.toLowerCase().replace(/\s+/g, '-')}`}>
						<div class="mb-3">
							<h2
								id={`cat-${category.toLowerCase().replace(/\s+/g, '-')}`}
								class="nm-category-header m-0"
							>
								{category}
							</h2>
						</div>
						<div class="flex flex-col gap-4">
							{categoryLinks.map((link) => (
								<LinkCard
									id={link.id}
									title={link.title}
									subtitle={link.subtitle}
									url={link.url}
									icon={link.icon}
									featured={link.featured}
								/>
							))}
						</div>
					</section>
				);
			})}

			<!-- Lead capture / Newsletter subscription widget -->
			<NewsletterCard />
		</div>
	</main>

	<Footer />
</BaseLayout>
